# Fridgedoor settings. Copy to .env and fill in what you need; everything is optional.
# Most things (AI provider, invites, the Google connection for Gmail and Calendar) can
# also be set in the web app.

# The address people use to reach Fridgedoor. Leave unset to have setup record the
# address you first open it at.
# PUBLIC_URL=https://fridgedoor.example.com

# Port on this machine. With Caddy, Tailscale or Cloudflare in front, also set
# FRIDGEDOOR_BIND=127.0.0.1 so the plain-HTTP port isn't reachable from outside.
# FRIDGEDOOR_PORT=8080
# FRIDGEDOOR_BIND=0.0.0.0

# --- HTTPS helpers (pick one; see docs/hosting) ---
# Caddy profile: a domain whose DNS A/AAAA record points at this server.
# DOMAIN=fridgedoor.example.com
# Tailscale profile: an auth key from https://login.tailscale.com/admin/settings/keys
# TS_AUTHKEY=tskey-auth-...
# TS_HOSTNAME=fridgedoor
# TS_SERVE_FILE=tailscale-serve-private.json   # only devices on your tailnet (no Funnel)
# Cloudflare profile: a tunnel token from Cloudflare Zero Trust > Networks > Tunnels
# TUNNEL_TOKEN=...

# --- AI (setting AI_PROVIDER here makes these read-only in the web app) ---
# Providers: openai, anthropic, gemini, openrouter, groq, mistral, deepseek, xai,
# together, fireworks, azure-openai, ollama, lmstudio, llamacpp, vllm, custom (any OpenAI-compatible API)
# AI_PROVIDER=anthropic
# AI_API_KEY=
# AI_MODEL=claude-sonnet-5-5
# AI_MODEL_EMAIL=claude-haiku-5-5   # optional cheaper model for reading email
# AI_BASE_URL=                      # for local servers, custom or azure-openai
# AI_STRUCTURED_OUTPUT=json_schema  # json_object or prompt for servers without JSON Schema support

# --- Google (Gmail and Google Calendar), optional ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Advanced ---
# FRIDGEDOOR_ROLE=all     # api or worker to run them as separate containers
# SETUP_TOKEN=            # choose the first-run setup token yourself (16+ characters)
# TRUST_PROXY=true        # only when reachable solely through Caddy, Tailscale or cloudflared
# CLIENT_IP_HEADER=       # with TRUST_PROXY: header holding the visitor's address (Fly-Client-IP, CF-Connecting-IP, X-Real-IP)
# SESSION_SECRET=         # otherwise generated and stored in the data volume
